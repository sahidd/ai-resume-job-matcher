# Copy to .env if you want to override the defaults. Docker Compose works without this file.
# Do not commit .env. Never put a real API key in git.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/matcher
SPRING_DATASOURCE_USERNAME=matcher
SPRING_DATASOURCE_PASSWORD=matcher
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# HS256 secret. Use at least 32 bytes outside this demo.
JWT_SECRET=dev-only-jwt-secret-change-me-please-32b

# Leave the model selectors unset (or "none") to run with the local hash embeddings
# and the rule-based answers. No API key is required.
# SPRING_AI_MODEL_CHAT=openai
# SPRING_AI_MODEL_EMBEDDING=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Switching embeddings to OpenAI means dropping vector_store and setting dimensions to 1536.
# APP_EMBEDDING_DIMENSIONS=1536

MANAGEMENT_OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces
